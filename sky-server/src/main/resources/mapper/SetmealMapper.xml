<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.sky.mapper.SetmealMapper">
    <update id="update" parameterType="com.sky.entity.Setmeal">
        update
            sky_take_out.setmeal s
        set
            s.
    </update>

    <select id="listSetmealByPage" parameterType="com.sky.dto.SetmealPageQueryDTO" resultType="com.sky.entity.Setmeal">
        select
            *
        from
            sky_take_out.setmeal s
        <where>
            <if test="categoryId != null">
                and s.categoryId = #{categoryId}
            </if>
            <if test="status != null">
                and s.status  = #{status}
            </if>
            <if test="name != null and name != ''">
                and s.name = #{name}
            </if>
        </where>
    </select>
</mapper>
